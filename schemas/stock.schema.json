{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/freeberserk/h0d-catalogue/blob/main/schemas/stock.schema.json",
  "title": "H0D — stock de scénario",
  "type": "object",
  "required": ["format", "formatVersion", "key", "name", "offres"],
  "properties": {
    "format": {"const": "H0D_EQUIPMENT_STOCK"},
    "formatVersion": {"const": 1},
    "key": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "merchant": {"type": "string"},
    "faction": {"type": "string"},
    "offres": {
      "type": "array", "items": {
        "type": "object",
        "required": ["reference", "nom_pour_la_scene", "prix_jetons", "quantite_disponible", "quantite_par_achat"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "nom_pour_la_scene": {"type": "string", "minLength": 1},
          "prix_jetons": {
            "oneOf": [
              {"type": "integer", "minimum": 0},
              {"type": "object", "required": ["min", "max"], "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}}, "additionalProperties": false}
            ]
          },
          "quantite_disponible": {"type": ["integer", "null"], "minimum": 0},
          "quantite_par_achat": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
